<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-rest-validation</artifactId>
    <name>Vertique REST Validation</name>
    <description>Default annotation-driven request validation strategy for the REST framework (web-validation gate)</description>

    <dependencies>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- SPI + descriptor types (OperationSchemaSource, JaxRsOperationDescriptor) -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-jaxrs</artifactId>
        </dependency>

        <!-- Startup-misconfiguration failure type (RestConfigurationException), load-bearing for the
             schema-synthesis and regex-precompilation failure contracts; BOM-managed, no version -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-core</artifactId>
        </dependency>

        <!-- JSON mapper profile SPI (JsonMapperProfile, the schema seam's second argument) -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>

        <!-- GA JSON-schema validation engine (the dialect target for synthesized schemas) -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-json-schema</artifactId>
        </dependency>

        <!-- Shared transport-neutral annotation -> JSON Schema generator (body-type synthesis) -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-json-schema</artifactId>
        </dependency>

        <!-- Annotation sources the schema generator introspects -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Built-in profile registry the seam proofs resolve their effective profile through
             (DefaultJsonMapperProfileRegistry) -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-json</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test scope only: SchemaCorpusMetadataCrossCheckTest exercises AnnotationSchemaSource's
             optional Validator with a real Bean Validation implementation. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Test sources only: ProfiledSchemaSynthesisIT's transforming-constructor gate-level proof
                 (rest-020-refresh, the InputPropertyDescriber#backingField compiled-parameter-name join
                 removal) needs its fixture's constructor parameter compiled with a Java name present at
                 runtime, which javac only emits under -parameters — mirrors vertique-json-schema's own
                 test-only default-testCompile override. Main sources are unaffected. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <parameters>true</parameters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The profile proofs in this module install the process JSON codec's mapper and restore
                 the raw Vert.x delegate in @AfterEach, so both forks enable the reset seam. The flag is
                 read once at VertiqueJson class initialization; it is a test-only argLine and never
                 reaches a shipped runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Reproduces the parent argLine (JaCoCo late-replacement + Mockito premain)
                         and adds the reset flag; a bare -D would drop both. -->
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
