<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-rest-auth-jwt</artifactId>
    <name>Vertique REST Auth JWT</name>
    <description>JWT bearer token authentication for the REST framework</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-security-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-auth-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: the action-only route claims-validator IT builds a router via the OpenAPI
             RouterBuilder. Test-scoped only — the preview router is NOT on the default
             runtime/compile path (it lives in the opt-in vertique-rest-openapi-validation module).
             Declared explicitly here because test-scoped dependencies are not transitive from
             vertique-rest-security. -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web-openapi-router</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: DefaultConfigParser/DefaultConfigMapper for constructing a ConfigParser in tests. -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-config-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: the claims-rejection status IT mounts a real JaxRsRouterMount, built through
             JwtClaimsRejectionComponent over RestTestFixtureModule, so a JwtClaimsValidator
             rejection reaches the router-level failure handler under test. rest-auth-jwt has NO
             production dependency on the JAX-RS runtime; it contributes to it through the neutral
             rest-core SPIs. This one test-scope dependency supplies the real JAX-RS runtime
             (vertique-rest-jaxrs) transitively, per the vertique-rest-test module contract. -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
