{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenApiContract sanitization test API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts": {
      "post": {
        "operationId": "createAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pin"],
                "properties": {
                  "pin": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    }
  }
}
