<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-rest-openapi-validation</artifactId>
    <name>Vertique REST OpenAPI Validation</name>
    <description>Opt-in OpenAPI-contract request validation strategy for the REST framework</description>

    <dependencies>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- SPI + descriptor types (RequestValidationStrategy, JaxRsOperationDescriptor, JaxRsConfig)
             and the RestValidationException / ValidationErrorDetail mapping targets (transitively from
             rest-core). -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-jaxrs</artifactId>
        </dependency>

        <!-- Preview standalone OpenAPI request validator. This module is the ONLY place the preview
             vertx-openapi artifact appears as a direct dependency (FR-025). Version is BOM-managed by
             vertx-dependencies. The RouterBuilder (vertx-web-openapi-router) is intentionally NOT a
             dependency: this strategy uses the standalone RequestValidator, not RouterBuilder. -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-openapi</artifactId>
        </dependency>

        <!-- Vert.x web (RoutingContext) and json-schema (OutputUnit for error detail mapping). -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-json-schema</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The profile proofs in this module install the process JSON codec's mapper and restore
                 the raw Vert.x delegate in @AfterEach, so both forks enable the reset seam. The flag is
                 read once at VertiqueJson class initialization; it is a test-only argLine and never
                 reaches a shipped runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Reproduces the parent argLine (JaCoCo late-replacement + Mockito premain)
                         and adds the reset flag; a bare -D would drop both. -->
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
