<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-input-processing</artifactId>
    <name>Vertique Input Processing</name>
    <description>Transport-neutral input processing pipeline applying declared canonicalization and sanitization policies</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Binds SLF4J at test scope so InvocationPolicyResolverTest/ReflectiveInvocationPoliciesTest
             can capture the inherited-skip WARN through a logback ListAppender (security review R2). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T018 (issue #379): compile-time-only, test-scope harness for the apt.ElementInvocationPolicies
             probe processor (TP-001). No cycle: vertique-codegen-test depends only on
             vertique-codegen-core, compile-testing, opentest4j and javapoet — no dev.vertique edge leads
             back to vertique-input-processing, and test scope is not transitive (evidence T018 § L00, A1). -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publishes the dev.vertique.input.processing.testkit fixture corpus (R03, finding #425)
                 as a test-jar so REST and MCP consume the exact same published corpus at test scope
                 instead of each authoring their own — mirrors vertique-config-core's identical pattern. -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
