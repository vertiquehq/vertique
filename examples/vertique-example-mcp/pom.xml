<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-example-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../vertique-example-parent/pom.xml</relativePath>
    </parent>

    <artifactId>vertique-example-mcp</artifactId>
    <name>Example: MCP</name>
    <description>Example application exposing a generated MCP tool over Streamable HTTP</description>

    <dependencies>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-application</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-config-core</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-core</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-deploy</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-json</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-mcp-core</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-mcp-server</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-rest-core</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-rest-security</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-sanitization</artifactId></dependency>
        <dependency><groupId>dev.vertique</groupId><artifactId>vertique-launcher</artifactId></dependency>
        <dependency><groupId>com.google.dagger</groupId><artifactId>dagger</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>io.vertx</groupId><artifactId>vertx-core</artifactId></dependency>
        <dependency><groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId></dependency>
        <dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId></dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
                <configuration><mainClass>dev.vertique.launcher.VertiqueApplication</mainClass></configuration>
            </plugin>
        </plugins>
    </build>
</project>
