<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-example-workflow-order-fulfillment</artifactId>
    <name>Example: Workflow Order Fulfillment</name>
    <description>Reference example demonstrating the durable saga pattern with order-fulfillment: reserve-inventory, authorize-payment, create-shipment with LIFO compensation.</description>

    <dependencies>
        <!-- Workflow modules -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-context</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-services</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-delayed</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-tasks</artifactId>
        </dependency>

        <!-- Job modules (transitive via vertique-workflow-delayed, declared explicitly) -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-delayed</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-cron</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-postgresql</artifactId>
        </dependency>

        <!-- Inbox/outbox modules -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-inbox-outbox-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-inbox-outbox-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-inbox-outbox-services</artifactId>
        </dependency>

        <!-- Services module -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-services</artifactId>
        </dependency>

        <!-- DB modules -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-flyway</artifactId>
        </dependency>

        <!-- Framework modules -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-deploy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-application</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-config-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-management</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-logging</artifactId>
        </dependency>

        <!-- DI -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- Vert.x -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-pg-client</artifactId>
        </dependency>

        <!-- Serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Compile-time only -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          Provided-scope reactor edge so Maven builds vertique-codegen-workflow before this module.
          Without it, <annotationProcessorPaths> alone does not create a reactor build edge and a clean
          reactor build may pick up a stale processor JAR from a previous build.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-workflow</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Provided-scope reactor edge so Maven builds vertique-codegen-application before this
          module. Without it, <annotationProcessorPaths> alone does not create a reactor build edge
          and a clean reactor build may pick up a stale processor JAR from a previous build.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-application</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-application-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Append the workflow + @VertiqueApp codegen processors to the parent's
                      annotationProcessorPaths (Dagger + Lombok). combine.children="append" preserves
                      the inherited processors; without it this example would lose Dagger/Lombok APT
                      and fail to compile.
                    -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>dev.vertique</groupId>
                            <artifactId>vertique-codegen-workflow</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>dev.vertique</groupId>
                            <artifactId>vertique-codegen-application</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
