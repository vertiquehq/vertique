<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-app-parent</artifactId>
        <version>@vertiqueVersion@</version>
        <relativePath/>
    </parent>

    <artifactId>starter-it-postgresql-consumer</artifactId>
    <version>1.0.0</version>

    <dependencies>
        <!--
            The one and only production dependency: the independent PostgreSQL persistence starter.
            No application framework is present at compile scope — that is exactly the independence
            this fixture proves.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-starter-postgresql</artifactId>
        </dependency>
        <!--
            Test scope only: the core application starter supplies the Vert.x seam, config parser,
            and lifecycle/deployment multibindings the persistence graph composes with. It is a
            graph-composition fixture, not part of the consumer's production ledger.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-starter-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>write-dependency-list</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/dependency-list.txt</outputFile>
                            <outputAbsoluteArtifactFilename>false</outputAbsoluteArtifactFilename>
                            <sort>true</sort>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
