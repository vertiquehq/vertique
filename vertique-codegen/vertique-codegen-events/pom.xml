<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-codegen-events</artifactId>
    <name>Vertique Codegen Events</name>
    <description>Annotation processor that builds the event-type inventory ((distinct @Observes T parameter types) ∪ (distinct constructor-injected Event&lt;T&gt; type arguments, unwrapping Provider/Lazy)) and generates a concrete X$Event extends Event&lt;X&gt; publisher plus a GeneratedEventsModule @Binds Event&lt;X&gt; for each inventory type so Event&lt;X&gt; is injectable</description>

    <dependencies>
        <!-- APT helpers from CG-001 -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-core</artifactId>
        </dependency>

        <!-- Events SPI — the processor reads @Observes and Event<T> at compile time -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-events</artifactId>
        </dependency>

        <!-- JavaPoet for code generation -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Dagger annotations (@Inject / Provider / Lazy) used by test fixtures -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
