<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-codegen-services</artifactId>
    <name>Vertique Codegen Services</name>
    <description>Annotation processor (CG-005) that generates ServiceContractContributor implementations and a Dagger
        @Module for @ServiceContract-annotated interfaces, eliminating startup-time reflection and turning structural
        mistakes into compiler errors.</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-resilience</artifactId>
        </dependency>
        <!-- APT helpers from CG-001 -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-core</artifactId>
        </dependency>

        <!-- JavaPoet for code generation -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito for roundtrip tests that mock ServiceRequestSender; vertx-junit5 for the
             ambient-SecurityContext roundtrip scenario, which requires a real duplicated Vert.x
             context (ContextValues.bind's write-side guard). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Annotation source for test fixtures: @ServiceContract, @ServiceOperation, ServiceHandler,
             ServiceContractContributor, ServiceContractEntries, etc. Test scope only — keeps them off
             the processor jar's runtime classpath. -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-services</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- For test fixtures: SecurityContext, Body, and @DispatchContextValue -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Dagger for module annotation constants in test assertions -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger-compiler</artifactId>
            <version>${dagger.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-config-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
