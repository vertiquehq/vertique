<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-codegen-dagger</artifactId>
    <name>Vertique Codegen Dagger</name>
    <description>Annotation processor that auto-generates Dagger @Module bindings from @Path, @RestClient, @KafkaListener, @KafkaSource, @ServiceContract implementations, and DelayedJobExecutor implementations</description>

    <dependencies>
        <!-- APT helpers from CG-001 -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-core</artifactId>
        </dependency>

        <!-- JavaPoet for code generation (RestClientModuleEmitter uses patterns not covered by DaggerModuleWriter helpers) -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-codegen-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Marker annotations — test scope only; keeps them off the processor jar's runtime classpath -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dagger annotation processor on test scope only — used by the migration-contract tests
             to validate that @NoAutoWire alongside a hand-written @Provides binding compiles
             cleanly through the actual Dagger compiler. -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger-compiler</artifactId>
            <version>${dagger.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-services</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-rest-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-kafka-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-delayed</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
