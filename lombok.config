# The framework deliberately stays on the Jackson 2.x line; Lombok 1.18.44+ otherwise warns that
# @Jacksonized is ambiguous whenever Jackson 3 is also on the compile classpath.
config.stopBubbling = true
lombok.jacksonized.jacksonVersion += 2
