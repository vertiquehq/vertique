#
# commit-msg hook — enforces Conventional Commits format.
# Install via: ./scripts/install-hooks.sh
#
# Format: <type>(<scope>): <description>
#   type:  feat|fix|refactor|test|docs|build|chore|style|perf|ci|revert
#   scope: optional, e.g. rest, core, audit
#   description: 1–100 characters, not ending with a period

MSG=$(cat "$1")

# Skip merge commits, fixup/squash commits, and revert commits generated by git
if echo "$MSG" | grep -qE "^(Merge|Revert|fixup!|squash!) "; then
    exit 0
fi

PATTERN='^(feat|fix|refactor|test|docs|build|chore|style|perf|ci|revert)(\([a-z0-9._-]+\))?: .{1,100}[^.]$'

if ! echo "$MSG" | grep -qE "$PATTERN"; then
    echo ""
    echo "  ✗ Commit message does not follow Conventional Commits format."
    echo ""
    echo "  Required format:"
    echo "    <type>(<scope>): <short description>"
    echo ""
    echo "  Types: feat, fix, refactor, test, docs, build, chore, style, perf, ci, revert"
    echo "  Scopes (optional): core, rest, audit, config, logging, rest-openapi-plugin, examples, bom"
    echo ""
    echo "  Examples:"
    echo "    feat(rest): add WebSocket upgrade support"
    echo "    fix(core): prevent NPE when translator returns null"
    echo "    docs: update coding conventions"
    echo ""
    echo "  Your message:"
    echo "    $MSG"
    echo ""
    exit 1
fi

exit 0
