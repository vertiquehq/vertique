<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-kafka-core</artifactId>
    <name>Vertique Kafka Core</name>
    <description>Format-agnostic Kafka runtime: serde SPI, producer/consumer infrastructure, and event bus dispatch</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-kafka-core-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- Direct deps only (searchTransitive=false) so vertx-core's transitive
                                         jackson-core is not flagged. The jackson groupId glob matches the
                                         breadth of com.fasterxml.jackson artifacts (core, databind,
                                         annotations, dataformat-*, datatype-*). -->
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson*:*</exclude>
                                        <exclude>org.apache.avro:*</exclude>
                                        <exclude>io.apicurio:*</exclude>
                                    </excludes>
                                    <includes>
                                        <!-- jackson-annotations is allowed at compile scope for typed config
                                             records (@JsonCreator, @JsonProperty). Per ADR-0107, config
                                             metadata annotations are inert; the actual deserialization is
                                             performed by the shared ConfigParser in vertique-core. -->
                                        <include>com.fasterxml.jackson.core:jackson-annotations</include>
                                        <!-- jackson-databind is allowed only at test scope for the
                                             runtime-IT JSON fixture (TestJsonSerdeProvider). -->
                                        <include>com.fasterxml.jackson.core:jackson-databind:*:*:test</include>
                                    </includes>
                                    <message>vertique-kafka-core must stay format-neutral: no direct Jackson serde engine, Avro, or Apicurio dependency (JSON serde lives in vertique-kafka-json, Avro in vertique-kafka-avro). jackson-annotations is permitted at compile scope for typed config records (ADR-0107); jackson-databind is allowed only at test scope for the runtime-IT fixture.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-context</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-services</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-deploy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-kafka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson annotations only — permitted at compile scope for typed config records
             (@JsonCreator, @JsonProperty) per ADR-0107. The serde engine (databind/core/dataformat)
             remains banned from src/main; actual deserialization runs in the shared ConfigParser
             (vertique-core). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: DefaultConfigParser/DefaultConfigMapper for constructing a ConfigParser in tests. -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-config-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
