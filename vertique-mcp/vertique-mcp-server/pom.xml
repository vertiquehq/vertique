<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>vertique-mcp-server</artifactId>
    <name>Vertique MCP Server</name>
    <description>HTTP server composition and lifecycle wiring for the Model Context Protocol</description>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-mcp-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-core</artifactId></dependency>
        <!-- T014: mandatory InputObjectProcessor composition binding (contract §4.7). -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-input-processing</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-json</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-json-schema</artifactId></dependency>
        <dependency><groupId>io.vertx</groupId><artifactId>vertx-json-schema</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-rest-core</artifactId></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-rest-security</artifactId></dependency>
        <!-- MCP-001 P04 remediation: stage 4 of the fixed request-time input pipeline (contract §4.7)
             is hosted by McpBeanValidation in vertique-mcp-core (public there so generated code in an
             arbitrary application package can reach it); its Bean Validation API/provider therefore
             come transitively via that dependency. Declared directly here at test scope only because
             McpInputPipelineIT's fixture carrier declares @NotBlank directly. -->
        <dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vertx</groupId><artifactId>vertx-web</artifactId></dependency>
        <dependency><groupId>com.google.dagger</groupId><artifactId>dagger</artifactId></dependency>
        <dependency><groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId></dependency>
        <dependency><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>3.27.7</version><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>1.5.0</version><scope>test</scope></dependency>
        <dependency><groupId>io.vertx</groupId><artifactId>vertx-junit5</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vertx</groupId><artifactId>vertx-web-client</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <!-- R02 TP-002 (issue #424): drives the retired-key rejection proof through the real
             DefaultConfigParser/DefaultConfigMapper production configuration mapper, not a bespoke
             test-local ObjectMapper (test scope only — vertique-mcp-server has no production
             dependency on the config-parsing module; an application composes McpServerConfig's
             binding itself). -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-config-core</artifactId><scope>test</scope></dependency>
        <!-- T012 TP-002: compiles a real @McpTool application source with the real annotation processor
             (test scope only — vertique-mcp-server never depends on the codegen module at compile/runtime). -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-codegen-mcp</artifactId><scope>test</scope></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-codegen-test</artifactId><scope>test</scope></dependency>
        <!-- T014 TP-001: runs the real Dagger ComponentProcessor over in-memory compile fixtures to
             prove a missing InputObjectProcessor binding fails Dagger compilation (test scope only). -->
        <dependency><groupId>com.google.dagger</groupId><artifactId>dagger-compiler</artifactId><version>${dagger.version}</version><scope>test</scope></dependency>
        <!-- R03 (finding #425): the published cross-transport input-processing fixture corpus,
             consumed identically by vertique-rest-jaxrs so both transports read the same artifact. -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>vertique-input-processing</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId></plugin></plugins></build>
</project>
