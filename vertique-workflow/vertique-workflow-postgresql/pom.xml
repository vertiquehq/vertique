<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-workflow-postgresql</artifactId>
    <name>Vertique Workflow PostgreSQL</name>
    <description>PostgreSQL persistence for workflow state machines: instance/history/dedup repositories, dialect adapters for the portable WorkflowEngine, optimistic concurrency, Flyway migrations.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-context</artifactId>
        </dependency>
        <!--
          Test-scope only: reuses vertique-workflow-engine's TenantCtx / TenantCtxCodec
          durable-context test fixtures (dev.vertique.workflow.engine.testsupport) instead of
          declaring a colocated duplicate, per the workflow-007 plan S6 fixture-consolidation note.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-deploy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-config-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-services</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-cron</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-pg-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-db-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-inbox-outbox-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-services</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-events</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Test scope only: the cross-scope migration proofs compare state types through the schema
          module's WorkflowStateCompatibility. No production code in this module depends on it.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-schema</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Test-scope only: the recorded-execution ITs assert durable-context fill against the real
          CorrelationContext type. No production code in this module depends on vertique-correlation.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-correlation</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only: the upgrade proofs create the delayed-job tables with the job module's own
          migration. No production code in this module depends on the job tables.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-job-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-workflow-definition</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-application</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Test scope only: PgWorkflowEnginePayloadConstraintIT enforces payload constraints through
          a real Hibernate Validator obtained from ValidationModule via a test Dagger component. No
          production code in this module depends on bean validation.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only: the relayed-signal proofs install identity carriage and reconstruction around a real
          outbox relay that delivers to the workflow signal endpoint. No production code in this module depends on
          the security runtime or on the outbox service destination.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-security-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-inbox-outbox-services</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only: ExecutorMetricsIT proves the Micrometer bridge against the executor on managed PostgreSQL.
          No production code in this module depends on the bridge.
        -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-micrometer-workflow</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Annotation processing of the Dagger components that the integration tests declare. -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger-compiler</artifactId>
            <version>${dagger.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
