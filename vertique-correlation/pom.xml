<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>vertique-correlation</artifactId>
    <name>Vertique Correlation</name>
    <description>Holder-bound CorrelationContext runtime (mutable impl, factory, mutator, encoders, seeder, Dagger module)</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>
        <dependency>
            <!-- Direct dep — module imports ServiceDispatchCodecs and InboundExecutionContextScope
                 from the substrate; transitive reach through vertique-logging is incidental. -->
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-context</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <!-- TP-002 (CorrelationEnvelopeTest): DefaultJsonMapperProfileRegistry + JacksonDefaults for
                 the cross-profile decode proof. Acyclic: vertique-json depends only on vertique-core. -->
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
        </dependency>
        <dependency>
            <!-- TP-002 (CorrelationEnvelopeTest): mocks the final DurableMetadata class to deliver a
                 single-quoted document past its copy-and-materialize accessors, straight into the
                 decoder's own readTree call (no real DurableMetadata body can otherwise carry
                 malformed JSON syntax — see the test's Javadoc). Needs the inline mock maker, hence
                 this module's surefire argLine below. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- TP-002 (CorrelationEnvelopeTest) installs a mapper through VertiqueJson.install and
                 must restore the raw Vert.x delegate in @AfterEach, so this module's single fork
                 enables the reset seam. The flag is read once at VertiqueJson class initialization; it
                 is a test-only argLine and never reaches a shipped runtime. Reproduces the parent
                 argLine (JaCoCo late-replacement + Mockito premain) exactly, as vertique-json/pom.xml
                 does. No failsafe override — this module has no integration tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
