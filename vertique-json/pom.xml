<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-json</artifactId>
    <name>Vertique JSON</name>
    <description>JSON mapper profile runtime: named ObjectMapper profiles, built-in system profile, the process JSON codec install step, Dagger wiring, and startup validation</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TP-002 boots a real application through VertiqueApplicationBootstrap. Acyclic:
             vertique-application depends on core + deploy, never on vertique-json, so a test-scope
             json -> application edge introduces no cycle (vertique-application-test would, through
             rest-jaxrs). -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-application</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Standard IT harness (docs/standards/testing.md): public IT class + VertxExtension. -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ListAppender log capture for the install step's WARN/INFO lines. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The install-step proofs drive the process-global Vertique JSON codec and restore the
                 raw Vert.x delegate in @AfterEach, so both forks of this module enable the reset
                 seam. The flag is read once at VertiqueJson class initialization; it is a test-only
                 argLine and never reaches a shipped runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Reproduces the parent argLine (JaCoCo late-replacement + Mockito premain)
                         and adds the reset flag; a bare -D would drop both. -->
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
