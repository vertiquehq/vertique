<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vertique</groupId>
        <artifactId>vertique-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vertique-json</artifactId>
    <name>Vertique JSON</name>
    <description>JSON mapper profile runtime: named ObjectMapper profiles, built-in system profile, the process JSON codec install step, Dagger wiring, and startup validation</description>

    <dependencies>
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A test boots a real application through VertiqueApplicationBootstrap. Acyclic:
             vertique-application depends on core + deploy, never on vertique-json, so a test-scope
             json -> application edge introduces no cycle (vertique-application-test would, through
             rest-jaxrs). -->
        <dependency>
            <groupId>dev.vertique</groupId>
            <artifactId>vertique-application</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Standard IT harness (docs/standards/testing.md): public IT class + VertxExtension. -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ListAppender log capture for the install step's WARN/INFO lines. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- PIT runs every test in one JVM and reads only plugin-level Surefire settings,
                     so it cannot reproduce the flagless reset-gate execution below: its minions get
                     the reset flag and the flagless refusal proof stays with Surefire. -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <configuration>
                        <jvmArgs>
                            <jvmArg>-Dvertique.json.codec.allowReset=true</jvmArg>
                        </jvmArgs>
                        <excludedTestClasses combine.children="append">
                            <param>*ProfileDelegatingJsonCodecResetGateTest</param>
                        </excludedTestClasses>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The codec and install-step proofs drive the process-global JSON codec and restore the
                 raw Vert.x profile in @AfterEach, so the default forks enable the reset seam. The flag
                 is read once at VertiqueJson class initialization, which is why the refusal half of the
                 reset-gate proof needs a fork that never saw it: the reset-gate execution below
                 overrides the plugin-level argLine. The flag is test-only and never reaches a shipped
                 runtime. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Reproduces the parent argLine (JaCoCo late-replacement + Mockito premain)
                         and adds the reset flag; a bare -D would drop both. -->
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <!-- Runs in the flagless execution below. -->
                                <exclude>**/ProfileDelegatingJsonCodecResetGateTest.java</exclude>
                                <!-- Surefire's default exclude, restated because declaring
                                     <excludes> replaces the default list. -->
                                <exclude>**/*$*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Flagless fork: proves resetForTests() stays refused when the JVM did
                             not start with -Dvertique.json.codec.allowReset=true, and that a later
                             System.setProperty cannot open the seam. -->
                        <id>reset-gate</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar</argLine>
                            <includes>
                                <include>**/ProfileDelegatingJsonCodecResetGateTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${project.build.directory}/mockito-agent.jar -Dvertique.json.codec.allowReset=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
