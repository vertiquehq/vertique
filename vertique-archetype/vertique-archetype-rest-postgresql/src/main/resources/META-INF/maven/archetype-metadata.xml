<archetype-descriptor xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype/1.2"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype/1.2 https://maven.apache.org/xsd/archetype-1.2.0.xsd"
                      name="vertique-archetype-rest-postgresql">

    <requiredProperties>
        <requiredProperty key="vertiqueVersion"/>
    </requiredProperties>

    <fileSets>
        <fileSet filtered="true" encoding="UTF-8">
            <includes>
                <include>pom.xml</include>
                <include>README.md</include>
            </includes>
        </fileSet>
        <!-- AGENTS.md is unfiltered: Velocity treats "##" as its comment token, so a filtered
             fileset silently strips level-two and deeper markdown headings from a rendered file (as it already
             does to README.md above). AGENTS.md carries no ${...} substitution, so filtering buys
             it nothing and only risks the same heading loss. -->
        <fileSet filtered="false" encoding="UTF-8">
            <includes>
                <include>AGENTS.md</include>
            </includes>
        </fileSet>
        <!-- packaged="true" renders this fileset below Maven Archetype's standard
             ${packageInPathFormat} destination. -->
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>AppComponent.java</include>
                <include>AppModule.java</include>
                <include>package-info.java</include>
                <include>model/CreateItemRequest.java</include>
                <include>model/UpdateItemRequest.java</include>
                <include>model/Item.java</include>
                <include>model/package-info.java</include>
                <include>repository/ItemRepository.java</include>
                <include>repository/package-info.java</include>
                <include>resource/ItemResource.java</include>
                <include>resource/package-info.java</include>
            </includes>
        </fileSet>
        <!-- Startup configuration lives in the generated project's root config/ directory, not on
             the classpath: the bootstrap loader scans config/ relative to the working directory. -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>config</directory>
            <includes>
                <include>application.json</include>
            </includes>
        </fileSet>
        <!-- The migration script is application-owned: Flyway runs it from the generated
             application's MIGRATE startup phase, never from a test container. It stays on the
             classpath, which is where the configured Flyway location resolves it. -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>db/migration/V1__create_items.sql</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>ApplicationIT.java</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
